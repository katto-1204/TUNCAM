{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "artifacts/tuncam"
  ],
  "scripts": {
    "dev": "pnpm --filter @workspace/tuncam run dev",
    "build": "pnpm run typecheck && pnpm -r run build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r run typecheck",
    "typecheck:libs": "tsc -b lib/api-zod lib/db && tsc -p lib/api-client-react --noEmit"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
